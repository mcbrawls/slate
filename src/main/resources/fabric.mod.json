{
    "schemaVersion": 1,

    "id": "slate",
    "version": "${version}",

    "name": "Slate",
    "description": "A library for creating clean server-side screens easily.",

    "authors": [
        "Andante"
    ],
    "contact": {
        "sources": "https://github.com/mcbrawls/slate"
    },

    "license": "MIT",
    "icon": "assets/slate/icon.png",

    "environment": "*",
    "entrypoints": {
        "main": [
            {
                "value": "net.mcbrawls.slate.SlateListeners",
                "adapter": "kotlin"
            }
        ]
    },

    "mixins": [
        "slate.mixins.json"
    ],
    "accessWidener": "slate.accesswidener",
    "custom": {
        "loom:injected_interfaces": {
            "net/minecraft/class_3222": [
                "net/mcbrawls/slate/SlatePlayer"
            ]
        }
    },

    "depends": {
        "minecraft": ">=1.21.6",
        "fabric-api": ">=0.128.0",
        "fabric-language-kotlin": "*"
    }
}
